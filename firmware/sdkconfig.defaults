CONFIG_IDF_TARGET="esp32s3"

# Waveshare ESP32-S3-ETH: 16MB flash, octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# mbedTLS allocates with plain malloc rather than from internal RAM only. The
# bridge holds up to three TLS sessions at once (the HomeConnect event stream,
# a REST call from the worker, and one from the web UI), each wanting a 16KB
# receive buffer in one piece. With SPIRAM_MALLOC_ALWAYSINTERNAL at 16384 those
# buffers come from PSRAM while Matter's small crypto allocations stay internal.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# Allocate Matter's buffers from PSRAM
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# lwip
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# disable softap by default
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# TLS to api.home-connect.com uses the bundled CA roots
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Increase Stack size
CONFIG_CHIP_TASK_STACK_SIZE=15360
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# Each bridged appliance takes one dynamic endpoint (plus the aggregator).
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=16

# Enable OTA Requestor
CONFIG_ENABLE_OTA_REQUESTOR=y

# Enable Ethernet
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# Transport
CONFIG_ENABLE_ETHERNET_TELEMETRY=y

# Use the ESP-IDF mdns component (not CHIP minimal-mDNS) so the app can
# register appliance-bridge.local via mdns_delegate_hostname_add
CONFIG_USE_MINIMAL_MDNS=n

# Disable Wi-Fi and Thread explicitly
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ENABLE_WIFI_TELEMETRY=n
CONFIG_ENABLE_MATTER_OVER_THREAD=n

# Disable BLE commissioning — not needed for on-network
CONFIG_BT_ENABLED=n
CONFIG_ENABLE_CHIPOBLE=n

CONFIG_ESP_HTTP_SERVER_TASK_STACKSIZE=8192

# WebSocket support for the live-events endpoint, and room for the SPA's headers
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Console over the board's USB serial/JTAG port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# TLS to the st-relay cloud service. IDF 5.5's TLS 1.3 client was unreliable
# against reverse proxies in matter-esp32-smartthings-adapter, so stay on 1.2.
# The relay's Caddy serves an RSA certificate (hardware-accelerated); the EC
# optimisation speeds up the ECDHE key exchange, which runs in software.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
