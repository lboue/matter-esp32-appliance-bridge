# Domain Caddy gets a certificate for (DNS must point at this host).
RELAY_DOMAIN=relay.example.com

# The public base URL of this service, no trailing slash.
PUBLIC_URL=https://relay.example.com

# From `smartthings apps:create` (OAuth-In app). See README.md.
ST_CLIENT_ID=
ST_CLIENT_SECRET=
# Must match the scopes granted to the app.
ST_SCOPE=r:devices:* x:devices:*

# Encrypts the stored SmartThings tokens. Generate once and keep it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional. When set, a bridge must present this to enrol, so strangers
# cannot create bridge records on your instance.
ENROLL_TOKEN=

LOG_LEVEL=INFO
